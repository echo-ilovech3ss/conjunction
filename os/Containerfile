# syntax=docker/dockerfile:1
# Conjunction OS base image (Fedora 45 Kinoite bootc, multi-arch: linux/amd64 + linux/arm64)
# Keep build-context small via `--ignorefile os/.containerignore`.

ARG BASE_IMAGE=quay.io/fedora/fedora-kinoite:45

# ==============================================================================
# Stage 1: Builder (toolchains, upstream assets, Rust workspace, Qt6/KF6/KWin C++)
# Shell/Design/KWin additions in conjunction-design/, conj-shelld/,
# conjunction-files/, conjunction-settings/, conjunction-terminal/, and kwin/
# are built uniformly in the CMAKE_COMPONENTS loop below.
# ==============================================================================
FROM ${BASE_IMAGE} AS builder

WORKDIR /src
# On bootc bases /root is a symlink to /var/roothome, which doesn't exist at build
# time, so cargo/git/tools can't create ~/.cargo or ~/.cache. Keep them in /tmp.
ENV CARGO_HOME=/tmp/cargo-home \
    HOME=/tmp

# 1. Install toolchains, Qt6/KF6/KWin development headers, and theme build helpers
RUN set -euo pipefail; \
    dnf5 --setopt=fastestmirror=True --setopt=max_parallel_downloads=10 install -y \
      cargo rust \
      cmake ninja-build gcc-c++ extra-cmake-modules \
      qt6-qtbase-devel qt6-qtdeclarative-devel qt6-qtsvg-devel qt6-qtshadertools-devel \
      kf6-kio-devel kf6-kconfig-devel kf6-solid-devel \
      kf6-networkmanager-qt-devel libkscreen-devel \
      kf6-kparts-devel kf6-kxmlgui-devel kf6-kcoreaddons-devel \
      kf6-ki18n-devel kf6-kwindowsystem-devel \
      kdecoration-devel kwin-devel libdrm-devel layer-shell-qt-devel libepoxy-devel \
      sassc glib2-devel gtk-murrine-engine \
      git unzip curl binutils xz; \
    dnf5 clean all

# 2. Fetch upstream fonts, MacTahoe themes, and (on aarch64) Wine-Proton WoW64 into /out
ARG PROTON_WINE_VERSION=proton-11.0-3
RUN set -euo pipefail; \
    mkdir -p \
      /out/usr/share/fonts/inter \
      /out/usr/share/fonts/material-symbols \
      /out/usr/share/icons \
      /out/usr/share/themes \
      /out/usr/share/licenses/conjunction; \
    # Inter & Inter Display v4.1 (OFL-1.1)
    curl -fsSL -o /tmp/Inter-4.1.zip https://github.com/rsms/inter/releases/download/v4.1/Inter-4.1.zip; \
    mkdir -p /tmp/inter-unpack; \
    unzip -q /tmp/Inter-4.1.zip -d /tmp/inter-unpack; \
    find /tmp/inter-unpack -type f \( -name 'InterVariable*.ttf' -o -path '*/extras/ttf/*.ttf' \) ! -path '*/hinted/*' \
      -exec install -Dm644 -t /out/usr/share/fonts/inter {} +; \
    if [ -z "$(ls -A /out/usr/share/fonts/inter)" ]; then \
      find /tmp/inter-unpack -type f \( -name '*.ttf' -o -name '*.otf' \) \
        -exec install -Dm644 -t /out/usr/share/fonts/inter {} +; \
    fi; \
    test -n "$(ls -A /out/usr/share/fonts/inter)"; \
    LICENSE_INTER="$(find /tmp/inter-unpack -maxdepth 3 -type f \( -iname 'OFL*' -o -iname 'LICENSE*' \) | head -n 1)"; \
    [ -n "${LICENSE_INTER}" ] && install -Dm644 "${LICENSE_INTER}" /out/usr/share/licenses/conjunction/Inter-OFL-1.1.txt; \
    rm -rf /tmp/Inter-4.1.zip /tmp/inter-unpack; \
    # Material Symbols Rounded variable font (Apache-2.0)
    curl -fsSL -o "/out/usr/share/fonts/material-symbols/MaterialSymbolsRounded[FILL,GRAD,opsz,wght].ttf" \
      "https://github.com/google/material-design-icons/raw/master/variablefont/MaterialSymbolsRounded%5BFILL%2CGRAD%2Copsz%2Cwght%5D.ttf"; \
    curl -fsSL -o /out/usr/share/licenses/conjunction/MaterialSymbolsRounded-Apache-2.0.txt \
      "https://raw.githubusercontent.com/google/material-design-icons/master/LICENSE"; \
    # MacTahoe icon theme (GPL-3.0)
    git clone --depth 1 https://github.com/vinceliuice/MacTahoe-icon-theme.git /tmp/MacTahoe-icon-theme; \
    (cd /tmp/MacTahoe-icon-theme && bash ./install.sh -d /out/usr/share/icons); \
    install -Dm644 /tmp/MacTahoe-icon-theme/COPYING /out/usr/share/licenses/conjunction/MacTahoe-icon-theme-GPL-3.0.txt; \
    rm -rf /tmp/MacTahoe-icon-theme; \
    # MacTahoe GTK theme (MIT in upstream COPYING)
    git clone --depth 1 https://github.com/vinceliuice/MacTahoe-gtk-theme.git /tmp/MacTahoe-gtk-theme; \
    (cd /tmp/MacTahoe-gtk-theme && \
      sed -i 's/^  install_app/  true/' install.sh && \
      sed -i 's/setterm /true /g' libs/lib-core.sh && \
      USER=root TERM=xterm-256color bash ./install.sh -d /out/usr/share/themes -c light -c dark -o normal -t default </dev/null); \
    install -Dm644 /tmp/MacTahoe-gtk-theme/COPYING /out/usr/share/licenses/conjunction/MacTahoe-gtk-theme-MIT.txt; \
    rm -rf /tmp/MacTahoe-gtk-theme; \
    # Portable x86_64 Wine-Proton WoW64 for FEX-Emu on aarch64
    if [ "$(uname -m)" = "aarch64" ]; then \
      mkdir -p /out/usr/share/conjunction/wine-x86_64 /out/usr/bin; \
      curl -fsSL -o /tmp/wine-proton.tar.xz \
        "https://github.com/Kron4ek/Wine-Builds/releases/download/${PROTON_WINE_VERSION}/wine-${PROTON_WINE_VERSION}-amd64-wow64.tar.xz"; \
      tar -xJf /tmp/wine-proton.tar.xz --strip-components=1 -C /out/usr/share/conjunction/wine-x86_64; \
      rm -f /tmp/wine-proton.tar.xz; \
      test -x /out/usr/share/conjunction/wine-x86_64/bin/wine; \
    fi

# 3. Copy repo in one layer, patch MacTahoe trademark icons, build Rust + C++/Qt6/KF6/KWin, and stage /out
COPY . /src

ARG CMAKE_COMPONENTS="conjunction-design conj-shelld conjunction-files conjunction-settings conjunction-terminal kwin data/dolphin-plugin"

RUN set -euo pipefail; \
    R="/src"; \
    # Replace trademarked start-here / distributor-logo / safari / finder artwork in MacTahoe icons
    MARK="${R}/assets/conjunction-mark.svg"; \
    for theme_dir in /out/usr/share/icons/MacTahoe*; do \
      [ -d "${theme_dir}" ] || continue; \
      GENERIC_NET="$(find "${theme_dir}" \( -path '*/apps/scalable/applications-internet.svg' -o -path '*/categories/scalable/applications-internet.svg' \) | head -n 1 || true)"; \
      GENERIC_FOLDER="$(find "${theme_dir}" \( -path '*/places/scalable/folder-blue.svg' -o -path '*/places/scalable/folder.svg' \) | head -n 1 || true)"; \
      find "${theme_dir}" \( -type f -o -type l \) \( -name 'start-here*.svg' -o -name 'distributor-logo*.svg' -o -name 'tapple.svg' -o -name 'safari*.svg' -o -name 'system-file-manager*.svg' \) | while IFS= read -r icon; do \
        base="$(basename "${icon}")"; \
        case "${base}" in \
          start-here*.svg|distributor-logo*.svg|tapple.svg) \
            rm -f "${icon}"; \
            cp "${MARK}" "${icon}"; \
            ;; \
          safari*.svg) \
            if [ -n "${GENERIC_NET}" ] && [ -e "${GENERIC_NET}" ]; then \
              rm -f "${icon}"; \
              cp -L "${GENERIC_NET}" "${icon}"; \
            fi; \
            ;; \
          system-file-manager*.svg) \
            if [ -n "${GENERIC_FOLDER}" ] && [ -e "${GENERIC_FOLDER}" ]; then \
              rm -f "${icon}"; \
              cp -L "${GENERIC_FOLDER}" "${icon}"; \
            fi; \
            ;; \
        esac; \
      done; \
    done; \
    # Build all Rust workspace binaries
    cargo build --release --locked; \
    mkdir -p /out/usr/bin; \
    for bin in cj application app_sync conj-bundle conj-appd conj-appctl conj-open conj-sysd; do \
      install -Dm755 "target/release/${bin}" "/out/usr/bin/${bin}"; \
    done; \
    # Build all C++/Qt6/KF6/KWin components and Dolphin KF6 plugin
    for proj in ${CMAKE_COMPONENTS}; do \
      BDIR="/tmp/build-$(printf '%s' "${proj}" | tr '/' '-')"; \
      cmake -S "${R}/${proj}" -B "${BDIR}" -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr; \
      cmake --build "${BDIR}"; \
      DESTDIR=/out cmake --install "${BDIR}"; \
      rm -rf "${BDIR}"; \
    done; \
    # Ensure conj-notificationd binary is installed even if upstream CMakeLists.txt omits install()
    cmake -S "${R}/conj-notificationd" -B /tmp/build-conj-notificationd -G Ninja \
      -DCMAKE_BUILD_TYPE=Release \
      -DCMAKE_INSTALL_PREFIX=/usr; \
    cmake --build /tmp/build-conj-notificationd; \
    install -Dm755 /tmp/build-conj-notificationd/conj-notificationd /out/usr/bin/conj-notificationd; \
    rm -rf /tmp/build-conj-notificationd; \
    # Complete QML module layout & reference_app alias expected by C++ loaders
    mkdir -p /out/usr/share/conjunction/qml /out/usr/lib64/qt6/qml/QtQuick/Controls; \
    cp -a "${R}/conjunction-design/qml/QtQuick" /out/usr/share/conjunction/qml/; \
    ln -sfn reference_app /out/usr/share/conjunction/reference; \
    ln -sfn /usr/share/conjunction/qml/Conjunction /out/usr/lib64/qt6/qml/Conjunction; \
    ln -sfn /usr/share/conjunction/qml/QtQuick/Controls/Conjunction /out/usr/lib64/qt6/qml/QtQuick/Controls/Conjunction; \
    # Verify compiled QSB shaders and KWin/Dolphin plugins
    test -f /out/usr/share/conjunction/qml/Conjunction/Design/shaders/liquid_glass.frag.qsb; \
    find /out -name '*.so' | tee /dev/stderr | grep -q 'conjunction'; \
    find /out/usr/bin -maxdepth 1 -type f -exec strip {} + 2>/dev/null || true; \
    # Stage Python Wine helpers, session, desktop/MIME/Polkit/DBus/KWin/Plasma/Terminal.app, and Fedora bootc overlays into /out
    install -Dm644 -t /out/usr/lib/conjunction "${R}/engine.py" "${R}/cli.py"; \
    install -Dm644 "${R}/data/conjunction.desktop" /out/usr/share/wayland-sessions/conjunction.desktop; \
    install -Dm755 "${R}/data/conjunction-session" /out/usr/bin/conjunction-session; \
    install -Dm755 "${R}/data/conjunction-session-init" /out/usr/bin/conjunction-session-init; \
    install -Dm644 -t /out/usr/share/applications \
      "${R}/data/conjunction-files.desktop" \
      "${R}/data/conjunction-settings.desktop" \
      "${R}/data/conjunction-terminal.desktop" \
      "${R}/data/applications/conjunction-cdmg.desktop" \
      "${R}/data/applications/conjunction-open.desktop"; \
    install -Dm644 "${R}/data/mime/packages/conjunction-bundles.xml" /out/usr/share/mime/packages/conjunction-bundles.xml; \
    install -Dm755 "${R}/data/kio/servicemenus/conjunction-app.desktop" /out/usr/share/kio/servicemenus/conjunction-app.desktop; \
    install -Dm644 "${R}/data/polkit-1/rules.d/50-conjunction-cdmg.rules" /out/etc/polkit-1/rules.d/50-conjunction-cdmg.rules; \
    install -Dm644 "${R}/data/org.conjunction.packages.policy" /out/usr/share/polkit-1/actions/org.conjunction.packages.policy; \
    install -Dm644 "${R}/data/org.conjunction.Notifications.service" /out/usr/share/dbus-1/services/org.conjunction.Notifications.service; \
    install -Dm644 "${R}/data/org.freedesktop.impl.portal.desktop.plasmanotify.service" /out/usr/share/dbus-1/services/org.freedesktop.impl.portal.desktop.plasmanotify.service; \
    install -Dm644 "${R}/data/environment.d/60-conjunction-apps.conf" /out/usr/lib/environment.d/60-conjunction-apps.conf; \
    install -Dm755 "${R}/data/plasma-env/conjunction-apps.sh" /out/etc/xdg/plasma-workspace/env/conjunction-apps.sh; \
    install -Dm644 "${R}/data/tmpfiles.d/conjunction-apps.conf" /out/usr/lib/tmpfiles.d/conjunction-apps.conf; \
    mkdir -p /out/usr/lib/systemd/user /out/usr/share/kwin/scripts/conjunction-kwin-bridge/contents/code /out/usr/share/kwin/effects/conjunction-overview /out/usr/share/conjunction/Applications/Terminal.app /out/usr/share/wallpapers/Conjunction /out/usr/share/plasma/look-and-feel /out/usr/share/conjunction/assets; \
    cp -a "${R}/data/systemd/user/." /out/usr/lib/systemd/user/; \
    install -Dm644 "${R}/data/conjunction-kwin-bridge.js" /out/usr/share/kwin/scripts/conjunction-kwin-bridge/contents/code/main.js; \
    cp -a "${R}/data/conjunction-overview/." /out/usr/share/kwin/effects/conjunction-overview/; \
    cp -a "${R}/data/Terminal.app/." /out/usr/share/conjunction/Applications/Terminal.app/; \
    cp -a "${R}/data/wallpapers/." /out/usr/share/wallpapers/Conjunction/; \
    cp -a "${R}/plasma/look-and-feel/." /out/usr/share/plasma/look-and-feel/; \
    cp -a "${R}/assets/." /out/usr/share/conjunction/assets/; \
    install -Dm644 "${R}/os/ASSETS-LICENSES.md" /out/usr/share/licenses/conjunction/ASSETS-LICENSES.md; \
    # Fedora bootc overrides + authoritative Plasma globals (kdeglobals, kwinrc)
    cp -a "${R}/os/files/." /out/; \
    install -Dm644 "${R}/plasma/kdeglobals" /out/etc/xdg/kdeglobals; \
    install -Dm644 "${R}/plasma/kwinrc" /out/etc/xdg/kwinrc

# ==============================================================================
# Stage 2: Final bootc OS image (single COPY --from=builder avoids overlay bloat)
# ==============================================================================
FROM ${BASE_IMAGE}

ARG TARGETARCH

LABEL org.opencontainers.image.title="Conjunction OS" \
      org.opencontainers.image.description="Conjunction desktop environment on Fedora 45 Kinoite bootc" \
      org.opencontainers.image.source="https://github.com/echo-ilovech3ss/conjunction" \
      containers.bootc="1"

# Copy compiled Rust & C++/KF6/KWin binaries, QML modules, shaders, plugins, fonts, themes, licenses, and overlays
COPY --from=builder /out/ /

# Configure Flathub, RPM Fusion, codecs/firmware/bundle tools, and arch-specific Windows/x86 compat
RUN set -euo pipefail; \
    export HOME=/tmp; \
    mkdir -p /etc/flatpak/remotes.d; \
    curl -fsSL -o /etc/flatpak/remotes.d/flathub.flatpakrepo https://dl.flathub.org/repo/flathub.flatpakrepo; \
    FEDORA_VER="$(rpm -E %fedora)"; \
    dnf5 --setopt=fastestmirror=True --setopt=max_parallel_downloads=10 install -y \
      "https://mirrors.rpmfusion.org/free/fedora/rpmfusion-free-release-${FEDORA_VER}.noarch.rpm" \
      "https://mirrors.rpmfusion.org/nonfree/fedora/rpmfusion-nonfree-release-${FEDORA_VER}.noarch.rpm"; \
    dnf5 --setopt=fastestmirror=True --setopt=max_parallel_downloads=10 install -y --allowerasing \
      distrobox \
      btrfs-progs \
      squashfs-tools \
      squashfuse \
      erofs-utils \
      erofs-fuse \
      fuse3 \
      desktop-file-utils \
      shared-mime-info \
      openssl \
      cabextract \
      alsa-firmware \
      alsa-sof-firmware \
      jetbrains-mono-fonts-all \
      fira-code-fonts \
      ffmpeg \
      libavcodec-freeworld \
      mesa-va-drivers-freeworld \
      gstreamer1-plugins-ugly \
      gstreamer1-plugins-bad-freeworld; \
    ARCH="$(uname -m)"; \
    if [ "${ARCH}" = "x86_64" ]; then \
      dnf5 copr enable -y bazzite-org/bazzite; \
      dnf5 --setopt=fastestmirror=True --setopt=max_parallel_downloads=10 install -y \
        wine wine-dxvk dxvk-native winetricks umu-launcher; \
    elif [ "${ARCH}" = "aarch64" ]; then \
      # FEX-Emu (2604 in Fedora 45 main repo) + x86_64 Fedora RootFS + binfmt_misc + thunks + Box64
      # Exclude box64-binfmts weak dep so FEX exclusively owns x86/x86_64 binfmt_misc handlers.
      dnf5 --setopt=fastestmirror=True --setopt=max_parallel_downloads=10 --setopt=install_weak_deps=False install -y \
        fex-emu fex-emu-rootfs-fedora fex-emu-thunks fex-emu-utils box64; \
      curl -fsSL -o /usr/bin/winetricks https://raw.githubusercontent.com/Winetricks/winetricks/master/src/winetricks; \
      chmod 0755 /usr/bin/winetricks; \
      # Global FEX configuration pointing to the Fedora x86_64 EROFS RootFS
      mkdir -p /usr/share/fex-emu /etc/skel/.fex-emu /etc/profile.d; \
      printf '{"Config":{"RootFS":"/usr/share/fex-emu/RootFS/default.erofs"}}\n' > /usr/share/fex-emu/Config.json; \
      cp /usr/share/fex-emu/Config.json /etc/skel/.fex-emu/Config.json; \
      printf 'FEX_ROOTFS=/usr/share/fex-emu/RootFS/default.erofs\n' > /usr/lib/environment.d/66-conjunction-fex.conf; \
      printf 'export FEX_ROOTFS="${FEX_ROOTFS:-/usr/share/fex-emu/RootFS/default.erofs}"\n' > /etc/profile.d/conjunction-fex.sh; \
      # Verify FEX binfmt_misc configs exist for systemd-binfmt on boot
      test -f /usr/lib/binfmt.d/FEX-x86.conf; \
      test -f /usr/lib/binfmt.d/FEX-x86_64.conf; \
      # Expose bundled x86_64 Wine-Proton WoW64 through FEXInterpreter so Windows .app bundles and winetricks work transparently
      for tool in wine wine64 wineboot winecfg wineserver msiexec regedit; do \
        printf '%s\n' \
          '#!/bin/sh' \
          'export FEX_ROOTFS="${FEX_ROOTFS:-/usr/share/fex-emu/RootFS/default.erofs}"' \
          "if [ -x \"/usr/share/conjunction/wine-x86_64/bin/${tool}\" ]; then" \
          "  exec /usr/bin/FEXInterpreter \"/usr/share/conjunction/wine-x86_64/bin/${tool}\" \"\$@\"" \
          'fi' \
          'exec /usr/bin/FEXInterpreter /usr/share/conjunction/wine-x86_64/bin/wine "$@"' \
          > "/usr/bin/${tool}"; \
        chmod 0755 "/usr/bin/${tool}"; \
      done; \
      printf '%s\n' \
        '#!/bin/sh' \
        'export FEX_ROOTFS="${FEX_ROOTFS:-/usr/share/fex-emu/RootFS/default.erofs}"' \
        'if [ "${1:-}" = "run" ]; then shift; fi' \
        'exec /usr/bin/FEXInterpreter /usr/share/conjunction/wine-x86_64/bin/wine "$@"' \
        > /usr/bin/proton; \
      chmod 0755 /usr/bin/proton; \
    else \
      echo "Unsupported architecture: ${ARCH}" >&2; \
      exit 1; \
    fi; \
    dnf5 clean all

# Finalize rootfs symlinks, units, branding (icons/Plymouth/Anaconda), caches, initramfs, and bootc lint
RUN set -euo pipefail; \
    export HOME=/tmp; \
    # Atomic writable /Applications backing directory
    ln -sfn var/Applications /Applications; \
    # Strip CRLF if present and fix permissions
    sed -i 's/\r$//' /etc/xdg/plasma-workspace/env/conjunction-apps.sh; \
    chmod 0755 \
      /usr/bin/conjunction-session \
      /usr/bin/conjunction-session-init \
      /etc/xdg/plasma-workspace/env/conjunction-apps.sh \
      /usr/share/kio/servicemenus/conjunction-app.desktop \
      /usr/share/conjunction/Applications/Terminal.app/Contents/MacOS/conjunction-terminal; \
    chmod 0644 /etc/polkit-1/rules.d/50-conjunction-cdmg.rules; \
    # Enable system & user units (conj-appd runs in both Conjunction and Plasma sessions)
    systemctl enable conj-sysd.service; \
    systemctl --global enable conj-appd.service conj-notificationd.service conj-shelld.service; \
    mkdir -p /usr/lib/systemd/user/graphical-session.target.wants; \
    ln -sfn ../conj-appd.service /usr/lib/systemd/user/graphical-session.target.wants/conj-appd.service; \
    # Install hicolor app icons & Conjunction brand pixmaps / Plymouth / Anaconda logos
    for sz in 16 24 32 48 64 128 256 512; do \
      install -Dm644 "/usr/share/conjunction/assets/icons/conjunction-${sz}.png" \
        "/usr/share/icons/hicolor/${sz}x${sz}/apps/conjunction.png"; \
    done; \
    install -Dm644 /usr/share/conjunction/assets/conjunction-logo.svg /usr/share/icons/hicolor/scalable/apps/conjunction.svg; \
    install -Dm644 /usr/share/conjunction/assets/conjunction.png /etc/favicon.png; \
    install -Dm644 /usr/share/conjunction/assets/conjunction.png /usr/share/pixmaps/system-logo-white.png; \
    install -Dm644 /usr/share/conjunction/assets/conjunction.png /usr/share/pixmaps/fedora-logo-sprite.png; \
    install -Dm644 /usr/share/conjunction/assets/conjunction.png /usr/share/pixmaps/fedora-logo.png; \
    install -Dm644 /usr/share/conjunction/assets/conjunction-installer.png /usr/share/pixmaps/fedora_logo_med.png; \
    install -Dm644 /usr/share/conjunction/assets/icons/conjunction-48.png /usr/share/plymouth/themes/spinner/watermark.png; \
    install -Dm644 /usr/share/conjunction/assets/icons/conjunction-128.png /usr/share/anaconda/pixmaps/sidebar-logo.png; \
    install -Dm644 /usr/share/conjunction/assets/icons/conjunction-128.png /usr/share/anaconda/pixmaps/silverblue/sidebar-logo.png; \
    # Refresh MIME, desktop, font, and icon caches
    update-mime-database /usr/share/mime; \
    update-desktop-database /usr/share/applications; \
    fc-cache -f; \
    for icon_dir in /usr/share/icons/hicolor /usr/share/icons/MacTahoe*; do \
      [ -d "${icon_dir}" ] && gtk-update-icon-cache -f -t "${icon_dir}" || true; \
    done; \
    # Rebuild initramfs so updated /usr/lib/os-release and Plymouth watermark are embedded
    KVER="$(ls -1 /usr/lib/modules | head -n 1)"; \
    dracut --no-hostonly --kver "${KVER}" --force "/usr/lib/modules/${KVER}/initramfs.img"; \
    # Clean caches/logs/tmp before bootc lint
    rm -rf /var/cache/libdnf5 /var/cache/dnf /var/log/* /tmp/* /var/tmp/*; \
    bootc container lint --fatal-warnings
