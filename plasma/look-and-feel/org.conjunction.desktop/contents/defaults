widgetStyle=Breeze
SingleClick=false

[kdeglobals][General]
ColorScheme=ConjunctionLight
font=Inter,13,-1,5,400,0,0,0,0,0
fixed=JetBrains Mono,12,-1,5,400,0,0,0,0,0
menuFont=Inter,13,-1,5,400,0,0,0,0,0
toolBarFont=Inter,11,-1,5,400,0,0,0,0,0
smallestReadableFont=Inter,10,-1,5,400,0,0,0,0,0

[kdeglobals][Icons]
