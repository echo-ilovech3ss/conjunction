[kdeglobals][Sounds]
Theme=ocean

[kdeglobals][Mouse]
cursorTheme=Bibata-Modern-Classic
cursorSize=24

[kwinrc][org.kde.kdecoration2]
library=org.conjunction.glass
theme=ConjunctionGlass
